# =============================================================================
# Media Stack — Jellyfin + Sonarr + Radarr + qBittorrentVPN
# =============================================================================

# Domain configuration
DOMAIN=yourdomain.com
TZ=Asia/Shanghai

# User/Group IDs
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Media Paths (host paths mapped to containers)
# ---------------------------------------------------------------------------
MEDIA_PATH=/mnt/media           # Root path for media library (movies, tv, music)
DOWNLOAD_PATH=/mnt/downloads   # Path for torrent downloads

# ---------------------------------------------------------------------------
# VPN Configuration for qBittorrentVPN
# ---------------------------------------------------------------------------
# VPN Type: wireguard, openvpn, mullvad, nordvpn, etc.
VPN_TYPE=wireguard

# VPN Provider (custom for WireGuard)
VPN_PROVIDER=custom

# WireGuard Configuration
# Paste your WireGuard config content here (base64 encoded or raw)
# Example: WIREGUARD_CONFIG=/config/vpn/wg0.conf
WIREGUARD_CONFIG=

# For Mullvad/NordVPN/etc, set these instead:
# Mullvad: VPN_TYPE=wireguard, set VPN_PROVIDER=mullvad
# NordVPN: VPN_TYPE=wireguard, set VPN_PROVIDER=nordvpn

# Optional: Path to custom VPN config files
VPN_CONFIG_PATH=./vpn

# ---------------------------------------------------------------------------
# Plex Compatibility Note:
# Jellyfin can import Plex metadata and libraries for easy migration.
# To use Plex libraries: Copy your Plex metadata to Jellyfin's config
# or use the Jellyfin-Plex plugin for live sync.
# ---------------------------------------------------------------------------
